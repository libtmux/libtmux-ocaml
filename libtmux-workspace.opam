opam-version: "2.0"
synopsis: "Validated native workspace plans for libtmux"
description: "Pure workspace validation, explicit plans and retained execution journals."
maintainer: "https://github.com/libtmux/libtmux-ocaml/issues"
authors: "libtmux contributors"
license: "MIT"
homepage: "https://libtmux.org/en/ocaml/"
doc: "https://libtmux.org/en/ocaml/latest/workspace/reference/libtmux_workspace/"
bug-reports: "https://github.com/libtmux/libtmux-ocaml/issues"
dev-repo: "git+https://github.com/libtmux/libtmux-ocaml.git"
depends: [
  "ocaml" {= "5.5.2"}
  "dune" {= "3.24.2"}
  "libtmux" {= version}
  "alcotest" {with-test & = "1.9.1"}
  "odoc" {with-doc & = "3.2.2"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} "@doc" {with-doc}]
]
