opam-version: "2.0"
synopsis: "Validate, preview and apply native JSON tmux workspaces"
description: "Installed tmux-workspace command with explicit endpoints and retained execution receipts."
maintainer: "https://github.com/libtmux/libtmux-ocaml/issues"
authors: "libtmux contributors"
license: "MIT"
homepage: "https://github.com/libtmux/libtmux-ocaml"
bug-reports: "https://github.com/libtmux/libtmux-ocaml/issues"
dev-repo: "git+https://github.com/libtmux/libtmux-ocaml.git"
available: os = "linux"
depends: [
  "ocaml" {= "5.5.2"}
  "dune" {= "3.24.2"}
  "libtmux" {= version}
  "libtmux-workspace" {= version}
  "libtmux-json" {= version}
  "libtmux-eio" {= version}
  "libtmux-unix" {= version}
  "eio_main" {= "1.6"}
  "cmdliner" {= "2.1.1"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
