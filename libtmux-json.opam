opam-version: "2.0"
synopsis: "Validated JSON queries for libtmux"
description: "Bounded, typed decoding of the shared libtmux pane filter schema."
maintainer: "https://github.com/libtmux/libtmux-ocaml/issues"
authors: "libtmux contributors"
license: "MIT"
homepage: "https://github.com/libtmux/libtmux-ocaml"
bug-reports: "https://github.com/libtmux/libtmux-ocaml/issues"
dev-repo: "git+https://github.com/libtmux/libtmux-ocaml.git"
depends: [
  "ocaml" {= "5.5.2"}
  "dune" {= "3.24.2"}
  "libtmux" {= version}
  "yojson" {= "3.0.0"}
  "alcotest" {with-test & = "1.9.1"}
  "odoc" {with-doc & = "3.2.2"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} "@doc" {with-doc}]
]
